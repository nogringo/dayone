# Private key for signing NIP-85 assertion events (nsec or hex format)
NSEC=nsec1...

# Relays to listen to for monitoring events (comma-separated)
RELAYS=wss://nostr-01.uid.ovh,wss://nostr-02.uid.ovh,wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# Relay to publish NIP-85 assertions to (comma-separated)
PUBLISH_RELAY=wss://nostr-01.uid.ovh,wss://nostr-02.uid.ovh,wss://relay.primal.net
